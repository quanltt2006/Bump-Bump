<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.arkanoid.game.controller.RegisterController" spacing="12" alignment="CENTER"
      stylesheets="@../css/style.css" prefWidth="800" prefHeight="600">
    <children>
        <Label text="Register" styleClass="title" />
        <TextField fx:id="usernameField" promptText="Username" />
        <TextField fx:id="emailField" promptText="Email" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <HBox spacing="8">
            <Button text="Submit" onAction="#onSubmit" />
            <Button text="Back" onAction="#onBack" />
        </HBox>
    </children>
    <padding><Insets topRightBottomLeft="24"/></padding>
</VBox>
